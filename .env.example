# Optional: use any OpenAI-compatible LLM endpoint.
LLM_PROVIDER=openai_compatible
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Retrieval
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TOP_K=8
MAX_RETRIES=2

# Security demo: admin sees all; finance sees finance/public; hr sees hr/public; engineering sees engineering/public
